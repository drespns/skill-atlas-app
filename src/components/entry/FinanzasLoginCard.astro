---
/** Tarjeta de acceso (correo + OAuth) para la home de entrada. */
---

<div
  class="w-full max-w-md rounded-2xl border border-gray-200/80 dark:border-gray-800 bg-white/95 dark:bg-gray-950/90 backdrop-blur p-6 shadow-sm flex flex-col"
>
  <div class="space-y-3">
    <p class="m-0 text-[11px] font-semibold uppercase tracking-wide text-indigo-700 dark:text-indigo-400">
      Finanzas
    </p>
    <h2 class="m-0 text-2xl font-semibold text-gray-900 dark:text-gray-100 leading-tight">
      Entra a tu cuaderno
    </h2>
    <p class="m-0 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
      Acceso por <strong class="font-semibold text-gray-800 dark:text-gray-200">invitación</strong> o cuenta ya
      activada. Correo y contraseña, o GitHub / LinkedIn.
    </p>
  </div>

  <div class="mt-5 rounded-xl border border-gray-200/70 dark:border-gray-800 bg-gray-50/80 dark:bg-gray-900/40 px-3 py-2.5">
    <p class="m-0 text-xs text-gray-600 dark:text-gray-400 leading-snug">
      ¿Sin invitación?
      <a
        href="/request-access"
        class="font-semibold text-gray-900 dark:text-gray-100 underline decoration-gray-400/80 underline-offset-2 hover:decoration-gray-600 dark:hover:decoration-gray-500"
      >
        Solicitar acceso
      </a>
    </p>
  </div>

  <form data-auth-password-form class="mt-5 space-y-4 flex-1">
    <div class="space-y-1">
      <p class="m-0 text-xs font-semibold text-gray-800 dark:text-gray-200">Correo y contraseña</p>
    </div>
    <div class="space-y-2">
      <label for="login-email" class="text-sm font-medium text-gray-800 dark:text-gray-200">Correo</label>
      <input
        id="login-email"
        data-auth-email
        type="email"
        autocomplete="username"
        placeholder="tu-email@dominio.com"
        required
        class="w-full rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-400/30 dark:focus:ring-indigo-600/40"
      />
    </div>
    <div class="space-y-2">
      <label for="login-password" class="text-sm font-medium text-gray-800 dark:text-gray-200">Contraseña</label>
      <input
        id="login-password"
        data-auth-password
        type="password"
        autocomplete="current-password"
        minlength={6}
        required
        class="w-full rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-400/30 dark:focus:ring-indigo-600/40"
      />
    </div>
    <button
      type="submit"
      data-auth-sign-in
      class="w-full inline-flex items-center justify-center rounded-lg bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white"
    >
      Entrar
    </button>
    <p data-auth-feedback class="text-sm text-gray-600 dark:text-gray-400 m-0"></p>
  </form>

  <div class="pt-2">
    <div class="flex items-center gap-3 mb-3">
      <div class="h-px flex-1 bg-gray-200 dark:bg-gray-800"></div>
      <span class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap">GitHub · LinkedIn</span>
      <div class="h-px flex-1 bg-gray-200 dark:bg-gray-800"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      <button
        type="button"
        data-auth-oauth-provider="github"
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 px-3 py-2.5 text-sm font-semibold text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-900"
      >
        <img src="/icons/login/github-icon-light.svg" alt="" class="h-4 w-4" />
        GitHub
      </button>
      <button
        type="button"
        data-auth-oauth-provider="linkedin_oidc"
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 px-3 py-2.5 text-sm font-semibold text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-900"
      >
        <img src="/icons/login/linkedin-icon.svg" alt="" class="h-4 w-4" />
        LinkedIn
      </button>
    </div>
  </div>
</div>
