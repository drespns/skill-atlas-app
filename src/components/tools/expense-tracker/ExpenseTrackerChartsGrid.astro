---
import ExpenseTrackerChartSlot from "./shared/ExpenseTrackerChartSlot.astro";
---

<div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
  <ExpenseTrackerChartSlot
    etSuffix="chart-line"
    class="rounded-2xl border border-gray-200/80 dark:border-gray-800 bg-white/80 dark:bg-gray-950/60 p-3 shadow-sm min-h-[300px]"
  />
  <ExpenseTrackerChartSlot
    etSuffix="chart-balance"
    class="rounded-2xl border border-fuchsia-200/70 dark:border-fuchsia-900/40 bg-gradient-to-r from-fuchsia-500/8 via-white/90 to-indigo-500/8 dark:from-fuchsia-950/25 dark:via-gray-950/60 dark:to-indigo-950/25 p-3 shadow-sm min-h-[300px]"
  />
</div>
