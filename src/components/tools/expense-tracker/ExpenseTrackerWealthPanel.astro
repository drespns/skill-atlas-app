---
import ExpenseTrackerTrackingBaseline from "./wealth/ExpenseTrackerTrackingBaseline.astro";
import ExpenseTrackerWealthToolbar from "./wealth/ExpenseTrackerWealthToolbar.astro";
import ExpenseTrackerChartSlot from "./shared/ExpenseTrackerChartSlot.astro";
---

<details
  class="group et-wealth-panel rounded-2xl border border-amber-300/50 dark:border-amber-800/50 bg-gradient-to-br from-amber-500/10 via-white/90 to-orange-500/8 dark:from-amber-950/35 dark:via-gray-950/55 dark:to-orange-950/20 open:shadow-md"
  data-et-wealth-panel
>
  <summary class="cursor-pointer list-none px-4 sm:px-5 py-4 flex flex-wrap items-center justify-between gap-3">
    <div class="min-w-0">
      <h2 class="m-0 text-lg font-semibold tracking-tight text-gray-900 dark:text-gray-50">Patrimonio — cuentas</h2>
      <p class="m-0 mt-1 text-xs text-gray-600 dark:text-gray-400 max-w-2xl">
        Efectivo por cuenta, traspasos internos e IBAN parcial. El total de <strong class="font-medium">Inversiones</strong> se suma al
        patrimonio.
      </p>
    </div>
    <span class="text-xs font-normal text-gray-500 dark:text-gray-400 shrink-0 group-open:hidden">Mostrar cuentas</span>
    <span class="text-xs font-normal text-gray-500 dark:text-gray-400 shrink-0 hidden group-open:inline">Ocultar</span>
  </summary>
  <div class="px-4 sm:px-5 pb-4 pt-0 space-y-3 border-t border-amber-200/40 dark:border-amber-900/35">
    <ExpenseTrackerTrackingBaseline />
    <ExpenseTrackerWealthToolbar />
    <div class="space-y-2" data-et-wealth-list></div>
    <ExpenseTrackerChartSlot
      etSuffix="chart-bizums"
      class="rounded-xl border border-cyan-200/60 dark:border-cyan-900/45 bg-white/70 dark:bg-gray-950/50 p-3 min-h-[220px] shadow-sm"
    />
    <p class="m-0 text-xs text-gray-500 dark:text-gray-400 hidden" data-et-wealth-empty>
      Aún no hay cuentas. Añade bancos, brokers o efectivo.
    </p>
  </div>
</details>
