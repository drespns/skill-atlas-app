<div
  data-et-kpi-detail-popover
  class="hidden fixed z-[60] w-[min(calc(100vw-1.5rem),22rem)] rounded-2xl border border-gray-200/90 dark:border-gray-700/90 bg-white/98 dark:bg-gray-950/98 backdrop-blur-md shadow-2xl p-0 overflow-hidden"
  role="dialog"
  aria-modal="false"
  aria-labelledby="et-kpi-detail-title"
>
  <div class="flex items-start justify-between gap-2 border-b border-gray-200/80 dark:border-gray-800/80 px-4 py-3">
    <div class="min-w-0">
      <h3 id="et-kpi-detail-title" class="m-0 text-sm font-semibold text-gray-900 dark:text-gray-50" data-et-kpi-detail-title>
        Detalle
      </h3>
      <p class="m-0 mt-0.5 text-[11px] text-gray-500 dark:text-gray-400" data-et-kpi-detail-subtitle></p>
    </div>
    <button
      type="button"
      data-et-kpi-detail-close
      class="shrink-0 inline-flex h-8 w-8 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 dark:text-gray-400"
      aria-label="Cerrar"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
      </svg>
    </button>
  </div>
  <div class="max-h-[min(60vh,20rem)] overflow-y-auto px-4 py-3 space-y-2" data-et-kpi-detail-body></div>
  <div class="border-t border-gray-200/80 dark:border-gray-800/80 px-4 py-2.5 flex justify-between items-center bg-gray-50/80 dark:bg-gray-900/40">
    <span class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Total</span>
    <span class="text-base font-bold et-amount text-gray-900 dark:text-gray-50" data-et-kpi-detail-total>—</span>
  </div>
</div>
