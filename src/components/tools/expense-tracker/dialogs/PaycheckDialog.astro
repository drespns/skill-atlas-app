    <dialog data-et-dlg-paycheck class="et-dialog et-dialog--form w-[min(100vw-1.5rem,40rem)] p-0">
      <div class="et-dialog-panel et-dialog-panel--fit space-y-3" data-et-paycheck-form>
        <h3 class="m-0 text-base font-semibold text-gray-900 dark:text-gray-50" data-et-paycheck-dialog-title>Ingreso previsto</h3>
        <input type="hidden" data-et-paycheck-id value="" />
        <label class="block space-y-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Nombre</span>
          <input type="text" data-et-paycheck-title class="et-field w-full text-sm py-2" placeholder="Nómina, subsidio…" />
        </label>
        <label class="block space-y-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Importe habitual (€)</span>
          <input type="number" step="0.01" min="0" data-et-paycheck-amount class="et-field w-full text-sm py-2 font-mono" />
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Mín. (opc.)</span>
            <input type="number" step="0.01" min="0" data-et-paycheck-min class="et-field w-full text-sm py-2 font-mono" />
          </label>
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Máx. (opc.)</span>
            <input type="number" step="0.01" min="0" data-et-paycheck-max class="et-field w-full text-sm py-2 font-mono" />
          </label>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Día del mes</span>
            <input type="number" min="1" max="31" value="1" data-et-paycheck-day class="et-field w-full text-sm py-2 font-mono" />
          </label>
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Ventana (días antes)</span>
            <input type="number" min="0" max="15" data-et-paycheck-window class="et-field w-full text-sm py-2 font-mono" placeholder="0" />
          </label>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Desde</span>
            <input type="date" data-et-paycheck-from class="et-field et-date w-full text-sm py-2 font-mono" />
          </label>
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Hasta (opc.)</span>
            <input type="date" data-et-paycheck-until class="et-field et-date w-full text-sm py-2 font-mono" />
          </label>
        </div>
        <label class="block space-y-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Nota</span>
          <input type="text" data-et-paycheck-note class="et-field w-full text-sm py-2" />
        </label>
        <details class="rounded-xl border border-gray-200/90 dark:border-gray-800 bg-gray-50/80 dark:bg-gray-900/40 px-3 py-2.5" open>
          <summary class="cursor-pointer text-xs font-semibold text-gray-800 dark:text-gray-200 select-none">Importe por mes (opcional)</summary>
          <p class="m-0 mt-2 mb-2 text-[11px] text-gray-500 dark:text-gray-400 leading-snug">
            Ajusta meses concretos dentro del rango de fechas (p. ej. nómina 1789 € un mes y 1800 € al siguiente).
          </p>
          <div class="max-h-[14rem] overflow-y-auto space-y-1.5 pr-1" data-et-paycheck-month-list></div>
        </details>
        <div class="flex justify-between gap-2 pt-1">
          <button type="button" class="text-sm font-semibold text-red-600 dark:text-red-400 hover:underline" data-et-paycheck-delete>Eliminar</button>
          <div class="flex gap-2">
            <button type="button" class="et-btn-secondary text-sm py-2" data-et-paycheck-cancel>Cancelar</button>
            <button type="button" class="et-btn-primary text-sm py-2" data-et-paycheck-save>Guardar</button>
          </div>
        </div>
      </div>
    </dialog>
