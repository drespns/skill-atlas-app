    <dialog data-et-dlg-planned class="et-dialog et-dialog--form w-[min(100vw-1.5rem,40rem)] p-0">
      <div class="et-dialog-panel et-dialog-panel--fit space-y-3" data-et-planned-form>
        <h3 class="m-0 text-base font-semibold text-gray-900 dark:text-gray-50" data-et-planned-dialog-title>Financiación / cuota</h3>
        <input type="hidden" data-et-planned-id value="" />
        <label class="block space-y-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Nombre</span>
          <input type="text" data-et-planned-title class="et-field w-full text-sm py-2" placeholder="Compra Klarna, alquiler…" />
        </label>
        <fieldset class="m-0 p-0 border-0 space-y-1.5">
          <legend class="text-xs font-semibold text-gray-600 dark:text-gray-300">Modo de pago</legend>
          <div class="flex flex-wrap gap-3 text-sm">
            <label class="inline-flex items-center gap-1.5 cursor-pointer">
              <input type="radio" name="et-planned-mode" value="installments" data-et-planned-mode checked class="h-4 w-4 text-rose-600" />
              A plazos
            </label>
            <label class="inline-flex items-center gap-1.5 cursor-pointer">
              <input type="radio" name="et-planned-mode" value="recurring" data-et-planned-mode class="h-4 w-4 text-rose-600" />
              Cuota fija mensual
            </label>
          </div>
        </fieldset>
        <div class="space-y-3" data-et-planned-installments-panel>
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Proveedor (opc.)</span>
            <div data-et-planned-financing-brand-host data-brand-hidden="plannedFinancing"></div>
            <input type="hidden" data-et-planned-financing-brand value="" />
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="block space-y-1">
              <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Entrada (opc.)</span>
              <input type="number" step="0.01" min="0" data-et-planned-down class="et-field w-full text-sm py-2 font-mono" placeholder="0" />
            </label>
            <label class="block space-y-1">
              <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Nº cuotas</span>
              <input type="number" min="1" max="120" value="3" data-et-planned-installments class="et-field w-full text-sm py-2 font-mono" />
            </label>
          </div>
        </div>
        <label class="block space-y-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300" data-et-planned-amount-label>Cuota mensual (€)</span>
          <input type="number" step="0.01" min="0" data-et-planned-amount class="et-field w-full text-sm py-2 font-mono" />
        </label>
        <label class="block space-y-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Categoría</span>
          <select data-et-planned-category class="et-field et-select w-full text-sm py-2"></select>
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Día del mes</span>
            <input type="number" min="1" max="31" value="1" data-et-planned-day class="et-field w-full text-sm py-2 font-mono" />
          </label>
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Ventana (días antes)</span>
            <input type="number" min="0" max="15" data-et-planned-window class="et-field w-full text-sm py-2 font-mono" placeholder="0" />
          </label>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Desde</span>
            <input type="date" data-et-planned-from class="et-field et-date w-full text-sm py-2 font-mono" />
          </label>
          <label class="block space-y-1">
            <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Hasta (opc.)</span>
            <input type="date" data-et-planned-until class="et-field et-date w-full text-sm py-2 font-mono" />
            <span class="hidden text-[10px] text-gray-500 dark:text-gray-400" data-et-planned-until-hint>Calculado desde Desde + Nº cuotas</span>
          </label>
        </div>
        <label class="block space-y-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Nota</span>
          <input type="text" data-et-planned-note class="et-field w-full text-sm py-2" />
        </label>
        <details class="rounded-xl border border-gray-200/90 dark:border-gray-800 bg-gray-50/80 dark:bg-gray-900/40 px-3 py-2.5" open>
          <summary class="cursor-pointer text-xs font-semibold text-gray-800 dark:text-gray-200 select-none">Importe por mes (opcional)</summary>
          <p class="m-0 mt-2 mb-2 text-[11px] text-gray-500 dark:text-gray-400 leading-snug">
            Deja vacío para usar la cuota habitual. Cambia solo los meses que necesites.
          </p>
          <div class="max-h-[14rem] overflow-y-auto space-y-1.5 pr-1" data-et-planned-month-list></div>
        </details>
        <div class="flex justify-between gap-2 pt-1">
          <button type="button" class="et-btn-danger text-sm py-2" data-et-planned-delete>Eliminar</button>
          <div class="flex gap-2">
            <button type="button" class="et-btn-secondary text-sm py-2" data-et-planned-cancel>Cancelar</button>
            <button type="button" class="et-btn-primary text-sm py-2" data-et-planned-save>Guardar</button>
          </div>
        </div>
      </div>
    </dialog>
