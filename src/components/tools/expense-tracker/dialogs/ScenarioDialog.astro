---
---

<dialog data-et-dlg-scenario class="et-dialog et-dialog--form w-[min(100vw-1.5rem,40rem)] p-0">
  <div class="et-dialog-panel et-dialog-panel--fit space-y-3" data-et-scenario-form>
    <h3 class="m-0 text-base font-semibold text-gray-900 dark:text-gray-50" data-et-scenario-dialog-title>Nueva simulación</h3>
    <input type="hidden" data-et-scenario-id value="" />
    <label class="block space-y-1">
      <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Tipo</span>
      <select data-et-scenario-kind class="et-field et-select w-full text-sm py-2">
        <option value="one_off">Compra única</option>
        <option value="installments">Cuotas / financiación</option>
        <option value="bundle">Viaje o varias partidas</option>
      </select>
    </label>
    <label class="block space-y-1">
      <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Nombre</span>
      <input type="text" data-et-scenario-title class="et-field w-full text-sm py-2" placeholder="Móvil nuevo, viaje Japón…" />
    </label>
    <label class="block space-y-1">
      <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Categoría (opc.)</span>
      <select data-et-scenario-category class="et-field et-select w-full text-sm py-2"></select>
    </label>
    <div class="space-y-3" data-et-scenario-panel-one-off>
      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Importe total (€)</span>
        <input type="number" step="0.01" min="0" data-et-scenario-amount class="et-field w-full text-sm py-2 font-mono" />
      </label>
      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Fecha prevista</span>
        <input type="date" data-et-scenario-target-date class="et-field et-date w-full text-sm py-2" />
      </label>
    </div>
    <div class="space-y-3 hidden" data-et-scenario-panel-installments>
      <div class="grid grid-cols-2 gap-3">
        <label class="block space-y-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Cuota mensual (€)</span>
          <input type="number" step="0.01" min="0" data-et-scenario-installment-amount class="et-field w-full text-sm py-2 font-mono" />
        </label>
        <label class="block space-y-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Nº cuotas</span>
          <input type="number" min="1" max="120" data-et-scenario-installment-count class="et-field w-full text-sm py-2 font-mono" />
        </label>
      </div>
      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Primer mes (YYYY-MM)</span>
        <input type="month" data-et-scenario-start-month class="et-field w-full text-sm py-2 font-mono" />
      </label>
    </div>
    <div class="space-y-3 hidden" data-et-scenario-panel-bundle>
      <div class="space-y-2" data-et-scenario-bundle-items></div>
      <button type="button" data-et-scenario-bundle-add class="et-btn-dashed text-xs py-1.5">+ Añadir partida</button>
      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Mes del gasto</span>
        <input type="month" data-et-scenario-bundle-month class="et-field w-full text-sm py-2 font-mono" />
      </label>
    </div>
    <label class="block space-y-1">
      <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Estado</span>
      <select data-et-scenario-status class="et-field et-select w-full text-sm py-2">
        <option value="idea">Idea</option>
        <option value="considering">Valorando</option>
        <option value="go">Quiero hacerlo</option>
        <option value="no_go">Descartado</option>
      </select>
    </label>
    <label class="block space-y-1">
      <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Notas</span>
      <input type="text" data-et-scenario-note class="et-field w-full text-sm py-2" placeholder="Opcional" />
    </label>
    <div class="flex justify-between gap-2 pt-1">
      <button type="button" data-et-scenario-delete class="text-sm font-semibold text-red-600 dark:text-red-400 hover:underline invisible">
        Eliminar
      </button>
      <div class="flex gap-2">
        <button type="button" data-et-scenario-cancel class="et-btn-secondary text-sm py-2">Cancelar</button>
        <button type="button" data-et-scenario-save class="et-btn-primary text-sm py-2">Guardar</button>
      </div>
    </div>
  </div>
</dialog>
