<dialog data-et-sub-dialog class="et-dialog et-sub-dialog p-0 w-[min(100vw-1.5rem,32rem)] max-w-[calc(100vw-1.25rem)]">
  <div class="divide-y divide-gray-100 dark:divide-gray-800 flex flex-col max-h-[min(92vh,720px)]" data-et-sub-form>
    <div class="px-5 py-4 flex items-start justify-between gap-3 shrink-0">
      <div>
        <h3 class="m-0 text-lg font-semibold" data-et-sub-dialog-title>Suscripción</h3>
        <p class="m-0 mt-1 text-xs text-gray-500 dark:text-gray-400">Logo, periodo de prueba y calendario de cobros.</p>
      </div>
      <button
        type="button"
        data-et-sub-close
        class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-900"
        aria-label="Cerrar"
      >
        ✕
      </button>
    </div>
    <div class="px-5 py-4 space-y-4 overflow-y-auto flex-1 min-h-0">
      <input type="hidden" data-et-sub-id value="" />
      <input type="hidden" data-et-sub-brand-key value="" />

      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Nombre</span>
        <input required data-et-sub-name class="et-field w-full text-sm py-2" placeholder="Spotify Premium, Movistar+…" />
      </label>

      <div class="space-y-1.5">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Marca / logo</span>
        <div class="flex flex-wrap gap-1.5 p-2 rounded-xl border border-gray-200/80 dark:border-gray-800/80 bg-gray-50/50 dark:bg-gray-900/30" data-et-sub-brand-grid></div>
        <p class="m-0 text-[10px] text-gray-500 dark:text-gray-400">Logos en <code class="text-[10px]">public/static/subscription-brands/</code>. «Auto» detecta desde el nombre.</p>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <label class="block space-y-1 col-span-2 sm:col-span-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Precio regular (€)</span>
          <input required type="number" step="0.01" min="0" data-et-sub-amount class="et-field w-full text-sm py-2 font-mono" placeholder="11,99" />
        </label>
        <label class="block space-y-1 col-span-2 sm:col-span-1">
          <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Ciclo de cobro</span>
          <select data-et-sub-cycle class="et-field w-full text-sm py-2">
            <option value="weekly">Semanal</option>
            <option value="monthly" selected>Mensual</option>
            <option value="quarterly">Trimestral</option>
            <option value="yearly">Anual</option>
          </select>
        </label>
      </div>

      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Alta / inicio (hoy si es nueva)</span>
        <input type="date" data-et-sub-billing-start class="et-field et-date w-full text-sm py-2" />
      </label>

      <div class="rounded-xl border border-emerald-200/70 dark:border-emerald-900/50 bg-emerald-50/40 dark:bg-emerald-950/20 p-3 space-y-3">
        <label class="flex items-center gap-2 text-sm font-semibold text-gray-800 dark:text-gray-100">
          <input type="checkbox" data-et-sub-trial-enabled class="h-4 w-4 rounded border-gray-300 text-emerald-600" />
          Periodo de prueba
        </label>
        <div class="space-y-3 hidden" data-et-sub-trial-fields>
          <div class="grid grid-cols-2 gap-3">
            <label class="block space-y-1">
              <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Importe en prueba (€)</span>
              <input type="number" step="0.01" min="0" data-et-sub-trial-amount class="et-field w-full text-sm py-2 font-mono" value="0" />
            </label>
            <label class="block space-y-1">
              <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Fin de prueba</span>
              <input type="date" data-et-sub-trial-ends class="et-field et-date w-full text-sm py-2" />
            </label>
          </div>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[10px] font-semibold text-gray-500 dark:text-gray-400 w-full">Duración rápida desde inicio:</span>
            <button type="button" data-et-sub-trial-1m class="et-btn-secondary text-xs py-1">1 mes</button>
            <button type="button" data-et-sub-trial-3m class="et-btn-secondary text-xs py-1">3 meses</button>
            <button type="button" data-et-sub-trial-6m class="et-btn-secondary text-xs py-1">6 meses</button>
          </div>
        </div>
      </div>

      <div class="rounded-xl border border-gray-200/80 dark:border-gray-800/80 bg-white/60 dark:bg-gray-950/40 p-3" data-et-sub-billing-preview-wrap>
        <p class="m-0 text-[10px] font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2">Vista previa de cobros</p>
        <div data-et-sub-billing-preview></div>
      </div>

      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Recordatorio (días antes del cobro)</span>
        <input type="number" min="0" max="60" step="1" data-et-sub-reminder-days class="et-field w-full text-sm py-2 font-mono" value="7" />
      </label>

      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Categoría</span>
        <select data-et-sub-category class="et-field w-full text-sm py-2"></select>
      </label>

      <label class="flex items-center gap-2 text-sm font-medium">
        <input type="checkbox" data-et-sub-active class="h-4 w-4 rounded border-gray-300 text-indigo-600" checked />
        Activa (cuenta en totales)
      </label>

      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Etiquetas (coma)</span>
        <input type="text" data-et-sub-tags class="et-field w-full text-sm py-2" placeholder="streaming, ocio" />
      </label>
      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Notas</span>
        <textarea data-et-sub-notes rows="2" class="et-field et-textarea w-full text-sm py-2 min-h-[3.25rem]"></textarea>
      </label>
      <label class="block space-y-1">
        <span class="text-xs font-semibold text-gray-600 dark:text-gray-300">Color de acento</span>
        <input type="color" data-et-sub-color class="et-field h-10 w-full cursor-pointer py-1" value="#6366f1" />
      </label>
    </div>
    <div class="px-5 py-4 flex items-center justify-between gap-2 bg-gray-50/80 dark:bg-gray-900/40 shrink-0">
      <button type="button" data-et-sub-delete class="text-sm font-semibold text-red-600 dark:text-red-400 hover:underline">
        Eliminar
      </button>
      <div class="flex gap-2">
        <button type="button" data-et-sub-cancel class="et-btn-secondary text-sm py-2">Cancelar</button>
        <button type="button" data-et-sub-save class="et-btn-primary text-sm py-2">Guardar</button>
      </div>
    </div>
  </div>
</dialog>
