<dialog data-et-dlg-year-history class="et-dialog p-0 w-[min(100vw-1.5rem,52rem)] max-w-[calc(100vw-1.25rem)]">
  <div class="et-dialog-panel space-y-3">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h3 class="m-0 text-base font-semibold text-gray-900 dark:text-gray-50" data-et-year-history-title>Proyección</h3>
        <p class="m-0 mt-1 text-xs text-gray-500 dark:text-gray-400">Gastos, ingresos e inversiones mes a mes</p>
      </div>
      <button type="button" class="et-btn-secondary text-sm py-1.5 px-2.5 shrink-0" data-et-year-history-close>Cerrar</button>
    </div>
    <div
      class="rounded-xl border border-violet-200/70 dark:border-violet-900/40 bg-gradient-to-br from-violet-500/6 via-white/90 to-indigo-500/6 dark:from-violet-950/25 dark:via-gray-950/55 dark:to-indigo-950/25 p-3 min-h-[280px]"
      data-et-chart-year-history
    ></div>
  </div>
</dialog>
