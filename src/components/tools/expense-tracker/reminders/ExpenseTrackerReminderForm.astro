<div class="flex flex-wrap gap-2 items-end" data-et-reminder-form>
  <label class="space-y-1">
    <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">Fecha</span>
    <input type="date" data-et-reminder-date class="et-field et-date py-1.5 text-sm w-[11rem]" disabled />
  </label>
  <label class="space-y-1 flex-1 min-w-[8rem]">
    <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">Título</span>
    <input type="text" data-et-reminder-title class="et-field py-1.5 text-sm w-full min-w-[8rem]" placeholder="Renovación hosting" disabled />
  </label>
  <label class="space-y-1 flex-1 min-w-[10rem]">
    <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">Nota</span>
    <input type="text" data-et-reminder-note class="et-field py-1.5 text-sm w-full min-w-[10rem]" disabled />
  </label>
  <label class="flex items-center gap-2 text-xs font-medium pt-5">
    <input type="checkbox" data-et-reminder-notify class="h-4 w-4 rounded border-gray-300 text-indigo-600" disabled />
    Notificar
  </label>
  <button type="button" data-et-reminder-add class="et-btn-primary py-2 text-sm" disabled>Añadir</button>
</div>
