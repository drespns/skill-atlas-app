---
interface Props {
  summary: string;
  openLabel?: string;
  closedLabel?: string;
  wrapperClass?: string;
  panelClass?: string;
}

const {
  summary,
  openLabel = "Ocultar",
  closedLabel = "Mostrar",
  wrapperClass = "group rounded-2xl border border-gray-200/90 dark:border-gray-800 bg-gray-50/70 dark:bg-gray-900/35 open:shadow-md",
  panelClass = "px-4 pb-4 pt-0 space-y-4 border-t border-gray-200/80 dark:border-gray-800",
} = Astro.props;
---

<details class={wrapperClass}>
  <summary class="cursor-pointer list-none px-4 py-3 flex items-center justify-between gap-2 font-semibold text-gray-900 dark:text-gray-100">
    <span>{summary}</span>
    <span class="text-xs font-normal text-gray-500 dark:text-gray-400 shrink-0 group-open:hidden">{closedLabel}</span>
    <span class="text-xs font-normal text-gray-500 dark:text-gray-400 shrink-0 hidden group-open:inline">{openLabel}</span>
  </summary>
  <div class={panelClass}>
    <slot />
  </div>
</details>
