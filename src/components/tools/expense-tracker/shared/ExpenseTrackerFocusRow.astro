---
interface Props {
  rowId: string;
  cols?: "2" | "3";
}

const { rowId, cols = "3" } = Astro.props;
const gridClass =
  cols === "2"
    ? "grid grid-cols-1 md:grid-cols-2 gap-4 et-focus-row"
    : "grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 et-focus-row";
---

<div class={gridClass} data-et-focus-row={rowId}>
  <slot />
</div>
