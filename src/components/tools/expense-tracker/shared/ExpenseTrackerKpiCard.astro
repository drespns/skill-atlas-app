---
interface Props {
  title: string;
  hint?: string;
  /** Suffix after `data-et-`, e.g. `kpi-subs` */
  etSuffix: string;
  breakdownEtSuffix?: string;
  cardClass: string;
  titleClass: string;
  valueClass?: string;
  colClass?: string;
}

const {
  title,
  hint,
  etSuffix,
  breakdownEtSuffix,
  cardClass,
  titleClass,
  valueClass = "mt-1 mb-0 text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-50",
  colClass = "",
} = Astro.props;

const valueAttr = { [`data-et-${etSuffix}`]: "" };
const breakdownAttr = breakdownEtSuffix ? { [`data-et-${breakdownEtSuffix}`]: "" } : undefined;
---

<div class:list={[cardClass, colClass]}>
  <p class:list={["m-0 text-xs font-semibold uppercase tracking-wide", titleClass]}>{title}</p>
  {hint && <p class="mt-1 mb-0 text-xs text-gray-500 dark:text-gray-400">{hint}</p>}
  <p class:list={[valueClass, "et-amount"]} {...valueAttr}>—</p>
  {breakdownAttr && <div class="space-y-1.5 text-sm" {...breakdownAttr} />}
</div>
