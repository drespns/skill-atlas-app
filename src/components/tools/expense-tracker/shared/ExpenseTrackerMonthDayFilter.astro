---
interface Props {
  monthEtSuffix: string;
  dayEtSuffix: string;
  hint: string;
  filterDays: number[];
}

const { monthEtSuffix, dayEtSuffix, hint, filterDays } = Astro.props;
const monthAttr = { [`data-et-${monthEtSuffix}`]: "" };
const dayAttr = { [`data-et-${dayEtSuffix}`]: "" };
---

<div class="flex flex-wrap items-end gap-3">
  <label class="space-y-1">
    <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">Mes</span>
    <input
      type="text"
      {...monthAttr}
      data-et-month-picker
      class="et-field et-date py-1.5 text-sm w-[11rem] cursor-pointer"
      readonly
      placeholder="Mes…"
    />
  </label>
  <label class="space-y-1">
    <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">Día</span>
    <select {...dayAttr} class="et-field et-select py-1.5 text-sm w-[8.5rem]">
      <option value="">Todo el mes</option>
      {filterDays.map((d) => (
        <option value={String(d)}>{d}</option>
      ))}
    </select>
  </label>
  <span class="text-xs text-gray-500 dark:text-gray-400 max-w-xl pb-1">{hint}</span>
</div>
