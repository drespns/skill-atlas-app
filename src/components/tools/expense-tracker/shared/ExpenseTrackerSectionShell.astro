---
interface Props {
  title: string;
  description: string;
  wrapperClass: string;
  /** Texto del tooltip al pasar el ratón por el icono de ayuda (opcional). */
  helpTooltip?: string;
}

const { title, description, wrapperClass, helpTooltip } = Astro.props;
---

<div class={wrapperClass}>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="flex items-start gap-2">
        <h2 class="m-0 text-lg font-semibold tracking-tight text-gray-900 dark:text-gray-50">{title}</h2>
        {
          helpTooltip ? (
            <span class="relative inline-flex shrink-0 group/et-help mt-0.5">
              <button
                type="button"
                class="flex h-5 w-5 items-center justify-center rounded-full border border-violet-300/80 bg-violet-100/80 text-[11px] font-bold leading-none text-violet-800 dark:border-violet-700 dark:bg-violet-950/60 dark:text-violet-200"
                aria-label="Cómo funciona esta sección"
              >
                !
              </button>
              <span
                role="tooltip"
                class="pointer-events-none absolute left-1/2 top-full z-20 mt-2 w-[min(100vw-2rem,22rem)] -translate-x-1/2 rounded-lg border border-violet-200/80 bg-white px-3 py-2 text-[11px] font-normal leading-relaxed text-gray-700 opacity-0 shadow-lg transition-opacity group-hover/et-help:opacity-100 group-focus-within/et-help:opacity-100 dark:border-violet-800/60 dark:bg-gray-950 dark:text-gray-200"
              >
                {helpTooltip}
              </span>
            </span>
          ) : null
        }
      </div>
      <p class="m-0 mt-1 text-xs text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed">{description}</p>
    </div>
    <slot name="actions" />
  </div>
  <slot />
</div>
