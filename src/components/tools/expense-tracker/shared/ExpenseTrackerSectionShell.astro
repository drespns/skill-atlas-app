---
import { expenseSectionIconSvg, type ExpenseSectionIconKey } from "@lib/expense-tracker-section-icons";

interface Props {
  title: string;
  description: string;
  wrapperClass: string;
  helpTooltip?: string;
  sectionId?: string;
  focusable?: boolean;
  icon?: ExpenseSectionIconKey;
}

const { title, description, wrapperClass, helpTooltip, sectionId, focusable, icon } = Astro.props;
const iconHtml = icon ? expenseSectionIconSvg(icon, 16) : "";
---

<div
  class="et-section-panel min-h-0"
  data-et-section-panel={sectionId}
>
  <div class={`${wrapperClass} h-full`}>
    <div
      class:list={[
        "flex flex-wrap items-start justify-between gap-3",
        focusable && "et-section-header group/header rounded-xl -mx-1 px-1 py-0.5 transition hover:bg-gray-100/60 dark:hover:bg-gray-900/40",
      ]}
      data-et-section-header={focusable ? sectionId : undefined}
      title={focusable ? "Click para ampliar" : undefined}
    >
      <div class="min-w-0 flex-1">
        <div class="flex items-start gap-2">
          {
            iconHtml ? (
              <span class="et-section-icon inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-gray-200/80 bg-white/80 text-gray-700 dark:border-gray-700 dark:bg-gray-900/60 dark:text-gray-200" set:html={iconHtml} />
            ) : null
          }
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <h2 class="m-0 text-lg font-semibold tracking-tight text-gray-900 dark:text-gray-50">{title}</h2>
              {
                focusable ? (
                  <span class="text-[10px] font-medium text-gray-400 opacity-0 transition group-hover/header:opacity-100 dark:text-gray-500">
                    Ampliar
                  </span>
                ) : null
              }
              {
                helpTooltip ? (
                  <span class="relative inline-flex shrink-0 group/et-help mt-0.5" data-et-no-section-modal>
                    <button
                      type="button"
                      class="flex h-5 w-5 items-center justify-center rounded-full border border-violet-300/80 bg-violet-100/80 text-[11px] font-bold leading-none text-violet-800 dark:border-violet-700 dark:bg-violet-950/60 dark:text-violet-200"
                      aria-label="Cómo funciona esta sección"
                    >
                      !
                    </button>
                    <span
                      role="tooltip"
                      class="pointer-events-none absolute left-1/2 top-full z-20 mt-2 w-[min(100vw-2rem,22rem)] -translate-x-1/2 rounded-lg border border-violet-200/80 bg-white px-3 py-2 text-[11px] font-normal leading-relaxed text-gray-700 opacity-0 shadow-lg transition-opacity group-hover/et-help:opacity-100 group-focus-within/et-help:opacity-100 dark:border-violet-800/60 dark:bg-gray-950 dark:text-gray-200"
                    >
                      {helpTooltip}
                    </span>
                  </span>
                ) : null
              }
            </div>
            <p class="m-0 mt-1 text-xs text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed">{description}</p>
          </div>
        </div>
      </div>
      <div class="shrink-0" data-et-no-section-modal>
        <slot name="actions" />
      </div>
    </div>
    <div class="mt-4" data-et-section-body>
      <slot />
    </div>
  </div>
</div>
