<div
  class="rounded-xl border border-amber-200/60 dark:border-amber-900/40 bg-amber-50/40 dark:bg-amber-950/20 p-3 space-y-2"
  data-et-tracking-baseline
>
  <p class="m-0 text-xs font-semibold text-amber-900 dark:text-amber-100">Punto de partida</p>
  <p class="m-0 text-[11px] text-gray-600 dark:text-gray-400 leading-snug">
    Indica desde qué fecha registras movimientos y el saldo que tenías entonces en cada cuenta (p. ej. 1 jun 2026).
  </p>
  <div class="flex flex-wrap items-end gap-2">
    <label class="space-y-1 min-w-[10rem]">
      <span class="text-[11px] font-semibold text-gray-500 dark:text-gray-400">Registro desde</span>
      <input type="date" data-et-tracking-start class="et-field et-date w-full text-sm py-2" />
    </label>
    <button type="button" data-et-tracking-apply class="et-btn-accent text-sm py-2">Fijar saldos iniciales</button>
  </div>
</div>
