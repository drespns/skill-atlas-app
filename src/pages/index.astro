---
import AppShell from "../layouts/AppShell.astro";
import FinanzasEntryShowcase from "../components/entry/FinanzasEntryShowcase.astro";
import FinanzasLoginCard from "../components/entry/FinanzasLoginCard.astro";

const title = "Finanzas";
---

<AppShell title={title} minimalChrome>
  <style is:global>
    :root {
      --app-main-px: 0px;
      --app-main-py: 0px;
    }
  </style>

  <section class="w-full min-h-svh overflow-hidden" data-finanzas-entry>
    <div class="grid md:grid-cols-2 min-h-svh md:h-svh min-h-0">
      {/* En móvil: login primero; en desktop: demo izq / login der */}
      <div class="order-2 md:order-1 min-h-0 md:h-full border-t md:border-t-0 md:border-r border-gray-200/80 dark:border-gray-800">
        <FinanzasEntryShowcase />
      </div>
      <div
        class="order-1 md:order-2 flex items-center justify-center px-5 py-8 md:px-10 md:py-6 min-h-0 overflow-y-auto bg-white dark:bg-gray-950 relative"
      >
        <div
          class="pointer-events-none absolute inset-0 opacity-40 dark:opacity-30 bg-linear-to-bl from-indigo-100/80 via-transparent to-transparent dark:from-indigo-950/50"
          aria-hidden="true"
        >
        </div>
        <div class="relative z-10 w-full flex justify-center">
          <FinanzasLoginCard />
        </div>
      </div>
    </div>
  </section>

  <script src="../scripts/login/login-auth.ts"></script>
  <script src="../scripts/landing/landing-tools-showcase.ts"></script>
</AppShell>
