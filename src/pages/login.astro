---
import AppShell from "../layouts/AppShell.astro";

/** Compat OAuth / bookmarks: reenvía a `/` conservando hash y query (tokens Supabase). */
const title = "Entrar";
---

<AppShell title={title} minimalChrome>
  <p class="p-8 text-sm text-gray-500">Redirigiendo…</p>
  <script is:inline>
    (function () {
      var q = window.location.search || "";
      var h = window.location.hash || "";
      window.location.replace("/" + q + h);
    })();
  </script>
</AppShell>
