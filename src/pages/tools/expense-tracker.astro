---
import AppShell from "../../layouts/AppShell.astro";
import ToolsPageHeader from "../../components/tools/ToolsPageHeader.astro";
import ExpenseTrackerSyncActions from "../../components/tools/expense-tracker/ExpenseTrackerSyncActions.astro";
import ExpenseTrackerMainSurface from "../../components/tools/expense-tracker/ExpenseTrackerMainSurface.astro";
import ExpenseTrackerSubscriptionsSection from "../../components/tools/expense-tracker/ExpenseTrackerSubscriptionsSection.astro";
import ExpenseTrackerFocusRow from "../../components/tools/expense-tracker/shared/ExpenseTrackerFocusRow.astro";
import ExpenseTrackerInvestmentsSection from "../../components/tools/expense-tracker/ExpenseTrackerInvestmentsSection.astro";
import ExpenseTrackerPlannedSection from "../../components/tools/expense-tracker/ExpenseTrackerPlannedSection.astro";
import ExpenseTrackerPaychecksSection from "../../components/tools/expense-tracker/ExpenseTrackerPaychecksSection.astro";
import ExpenseTrackerScenariosSection from "../../components/tools/expense-tracker/scenarios/ExpenseTrackerScenariosSection.astro";
import ExpenseTrackerDebtsSection from "../../components/tools/expense-tracker/debts/ExpenseTrackerDebtsSection.astro";
import ExpenseTrackerExpensesTable from "../../components/tools/expense-tracker/ExpenseTrackerExpensesTable.astro";
import ExpenseTrackerIncomeTable from "../../components/tools/expense-tracker/ExpenseTrackerIncomeTable.astro";
import ExpenseTrackerRemindersSection from "../../components/tools/expense-tracker/ExpenseTrackerRemindersSection.astro";
import ExpenseTrackerChartsGrid from "../../components/tools/expense-tracker/ExpenseTrackerChartsGrid.astro";
import ExpenseTrackerPeriodAnalyticsSection from "../../components/tools/expense-tracker/ExpenseTrackerPeriodAnalyticsSection.astro";
import ExpenseTrackerDialogs from "../../components/tools/expense-tracker/ExpenseTrackerDialogs.astro";
import ExpenseTrackerStyles from "../../components/tools/expense-tracker/ExpenseTrackerStyles.astro";

const title = "Gastos y suscripciones";
const filterDays = Array.from({ length: 31 }, (_, i) => i + 1);
---

<AppShell title={title} mainWidth="wide">
  <div data-requires-auth class="hidden"></div>
  <section class="space-y-6 w-full et-page-wide" data-tools-expense-page>
    <ToolsPageHeader titleI18nKey="tools.expenseTrackerTitle" title={title}>
      <div slot="intro">
        <p class="m-0 text-sm md:text-base text-gray-600 dark:text-gray-400 leading-relaxed">
          Tus datos viven en este navegador. Activa la copia en tu cuenta (derecha) para sincronizar; solo tú ves tu hoja.
          Con <strong class="font-medium text-gray-800 dark:text-gray-200">frase del cuaderno</strong>, la copia en nube queda cifrada end-to-end.
        </p>
      </div>
      <ExpenseTrackerSyncActions slot="actions" />
    </ToolsPageHeader>

    <p class="hidden m-0 text-sm text-amber-900 dark:text-amber-100/95 max-w-3xl" data-et-e2e-outside-hint>
      Hay una copia en tu cuenta protegida con frase.
      <button type="button" class="font-semibold underline ml-1" data-et-sync-open-popover>Abrir ajustes</button>
    </p>

    <ExpenseTrackerMainSurface />
    <ExpenseTrackerSubscriptionsSection />
    <ExpenseTrackerFocusRow rowId="recurring" cols="3">
      <ExpenseTrackerInvestmentsSection />
      <ExpenseTrackerPlannedSection />
      <ExpenseTrackerPaychecksSection />
    </ExpenseTrackerFocusRow>
    <ExpenseTrackerFocusRow rowId="planning" cols="2">
      <ExpenseTrackerScenariosSection />
      <ExpenseTrackerDebtsSection />
    </ExpenseTrackerFocusRow>
    <ExpenseTrackerExpensesTable filterDays={filterDays} />
    <ExpenseTrackerIncomeTable filterDays={filterDays} />
    <ExpenseTrackerRemindersSection />
    <ExpenseTrackerChartsGrid />
    <ExpenseTrackerPeriodAnalyticsSection />

    <ExpenseTrackerDialogs />
  </section>

  <ExpenseTrackerStyles />

  <script src="../../scripts/tools/expense-tracker.ts"></script>
</AppShell>
